DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
INTERNAL_CRON_SECRET="replace-with-a-long-random-string"
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
PORT=3001
# Comma-separated allowed CORS origins for production (e.g. the deployed Vercel frontend URL).
# Leave unset in local dev — the app allows any origin when this is empty.
